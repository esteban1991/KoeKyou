{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceMaster Pro",
  "version": "0.1.0",
  "identifier": "com.voicemaster.pro",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "docker compose up -d --build --wait",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VoiceMaster Pro",
        "width": 1280,
        "height": 880,
        "minWidth": 750,
        "minHeight": 680,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:8000; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../compose.yaml": "docker/compose.yaml",
      "../backend/": "docker/backend/",
      "../Dockerfile": "docker/Dockerfile",
      "../nginx.conf": "docker/nginx.conf",
      "../package.json": "docker/package.json",
      "../index.html": "docker/index.html",
      "../vite.config.js": "docker/vite.config.js",
      "../src/": "docker/src/",
      "../public/": "docker/public/"
    }
  }
}